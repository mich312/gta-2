{
  "name": "topdown-city",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b server",
    "dev": "pnpm build && pnpm -r --parallel dev",
    "server": "pnpm build && node server/dist/index.js",
    "bots": "pnpm build && node server/dist/bots/harness.js",
    "replay": "pnpm build && node server/dist/replay/run.js",
    "citybake": "pnpm build && node server/dist/tools/citybake.js",
    "mapgen": "pnpm build && node server/dist/tools/mapgen.js",
    "chase": "pnpm build && node server/dist/tools/chase.js",
    "sprites": "pnpm build && node server/dist/tools/sprites.js",
    "parity": "pnpm build && node ci/hostParity.mjs",
    "bench": "node ci/renderBench.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
