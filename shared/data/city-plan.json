  "boroughs": [
    {
      "name": "Kelvin",
      "note": "North bank of the strait, east end: the old quarter round the harbour and the financial spine behind it. Tightest streets in the city, and the only ones with alleys worth running down."
    },
    {
      "name": "Ravenhill",
      "note": "North bank, west end: nineteenth-century commercial grid, the park, and the terraces climbing away from the water."
    },
    {
      "name": "Sunridge",
      "note": "South bank: the seafront, the suburbs behind it, and the ground they were built on."
    },
    {
      "name": "Marsh End",
      "note": "The south-east: flats, the airfield and the coast road out to the spit."
    },
    {
      "name": "Port Vasco",
      "note": "The island across the sound. Docks, foundry and the housing that serves them."
    },
    {
      "name": "Gannet Rock",
      "note": "The plateau in the western approaches. Cliff the whole way round, so there is nowhere to bring a boat alongside \u2014 the strip on top is the only way in and the only way out."
    }
  ],
